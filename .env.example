# Copy to .env and fill in. Never commit the real .env file.

# Postgres (matches secrets/pg_password.txt)
DATABASE_URL=postgresql://spread_app:CHANGE_ME@postgres:5432/spread_dashboard

# Alpaca free plan — https://alpaca.markets/data
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Solana RPC (xStocks multiplier read on-chain, no key needed) — override
# for a paid/faster RPC provider later if the public endpoint rate-limits.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Dinari API — https://dinari.com/
DINARI_API_KEY_ID=
DINARI_API_SECRET_KEY=

# Poller cadence in seconds (default: every 5 minutes)
POLL_INTERVAL_SECONDS=300
